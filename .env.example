# ─────────────────────────────────────────────────────────────────────────────
# DPM-101 Helpdesk Chatbot — environment variable template
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is excluded by .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Gemini model ID (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Generation parameters (Module 4)
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_REQUEST_TIMEOUT=30.0
GEMINI_MAX_RETRIES=2

# Flask debug mode — set to True for local development, False for production
FLASK_DEBUG=False

# Flask secret key — change to a long random string in production
FLASK_SECRET_KEY=change-me-in-production
